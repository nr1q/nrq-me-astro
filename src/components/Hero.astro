<section class="container mx-auto px-6 py-16 md:py-24 lg:py-32 static z-10 -mt-10">
  <div class="grid lg:grid-cols-[42rem_auto] xl:grid-cols-[53.5rem_auto] gap-8 2xl:gap-16 items-center h-[calc(90svh)]">
    <div class="order-2 lg:order-1 mix-blend-difference">
      <h1
        data-hero-lines
        class="invisible font-display text-[clamp(1.8rem,6vw,5rem)] leading-[0.95] [word-spacing:0.5rem] sm:[word-spacing:1.618rem] tracking-[3px] text-foreground"
      >
        I'm a web developer specialized in frontend, crafting effective web experiences since 2010<br />
        — living in Mexico City, working remote.
      </h1>
      <p data-hero-scroll class="mt-[5vh] font-display text-[0.75rem] text-center lg:text-right uppercase tracking-[4px] sm:tracking-[0.8rem]">scroll down to explore</p>
    </div>
    <div class="order-1 lg:order-2 flex max-sm:self-end justify-center lg:justify-end isolate">
      <div
        data-hero-portrait
        class="w-48 h-48 md:w-70 md:h-70 xl:w-80 xl:h-80 overflow-hidden bg-card rounded-full-none"
        style="clip-path: circle(0%);"
      >
        <img
          src="/images/nriq.jpeg"
          alt="Enrique Mendoza"
          width="640"
          height="640"
          class="w-full h-full object-cover xl:grayscale hover:grayscale-0 transition-all duration-700"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero-lines] :global(.line) {
    display: block;
    width: 100%;
    text-align-last: left;

    .word {
      opacity: 0;
      filter: blur(16px);
      transform: translateY(32px);
      will-change: transform, opacity, filter;
    }
  }

  [data-hero-portrait] {
    opacity: 0;
    will-change: clip-path, opacity;
  }

  [data-hero-scroll] {
    opacity: 0;
    will-change: opacity;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import SplitType from 'split-type';

  const heading = document.querySelector('[data-hero-lines]') as HTMLElement | null;
  const portrait = document.querySelector('[data-hero-portrait]') as HTMLElement | null;
  const scrollText = document.querySelector('[data-hero-scroll]') as HTMLElement | null;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function revealFinal() {
    if (heading) heading.style.opacity = '1';
    if (portrait) {
      portrait.style.opacity = '1';
      portrait.style.clipPath = 'circle(0%)';
    }
    if (scrollText) scrollText.style.opacity = '1';
  }

  if (!heading || prefersReducedMotion) {
    revealFinal();
  } else {
    let split: SplitType | null = null;

    function runEntrance() {
      split = new SplitType(heading, { types: 'lines, words' });

      const tl = gsap.timeline({ defaults: { ease: 'circ.out' }, delay: 2 });

      tl.call(() => heading.classList.remove('invisible'))
        .to(split.words, {
          opacity: 1,
          y: 0,
          filter: 'blur(0px)',
          duration: 1.8,
          stagger: 0.3,
        })
      ;

      if (portrait) {
        tl.to(
          portrait,
          {
            opacity: 1,
            clipPath: 'circle(50%)',
            duration: 1.7,
            ease: 'circ.out',
          },
          // '-=0.6'
          '<'
        );
      }

      if (scrollText) {
        tl.to(
          scrollText,
          {
            opacity: 1,
            duration: 0.6,
            delay: 0.5,
          },
          '-=0.4'
        );
      }
    }

    if ((window as any).__heroCanvasReady) {
      runEntrance();
    } else {
      window.addEventListener('hero:canvas-ready', runEntrance, { once: true });
    }

    document.addEventListener('astro:before-swap', () => {
      split?.revert();
    });
  }
</script>
